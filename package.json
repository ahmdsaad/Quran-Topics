{
  "name": "quran-classification",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm run fetch && npm run corpus",
    "fetch": "node scripts/fetch-sources.mjs",
    "corpus": "node scripts/build-corpus.mjs",
    "fonts:v2": "python3 scripts/convert-v2-fonts.py",
    "prebuild": "node scripts/fetch-sources.mjs && node scripts/build-corpus.mjs",
    "dev": "next dev -p 3000",
    "dev:lan": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000",
    "start:lan": "next start -p 3000 -H 0.0.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-youtube": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "fractional-indexing": "^4.0.0",
    "minisearch": "^7.2.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.15"
